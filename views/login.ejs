<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Mi Agenda Escolar</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <div class="notebook-container">
        <header class="login-header">
            <div class="notebook-icon">🎒</div>
            <h1>Mi Agenda Escolar</h1>
            <p>¡Ingresa tus datos para comenzar a organizar tus proyectos!</p>
        </header>

        <section class="form-section">
            <form action="/login" method="POST" class="login-form">
                <div class="input-group">
                    <label for="nombre">Nombre:</label>
                    <input type="text" id="nombre" name="nombre" placeholder="Ej. Ana Pérez (Solo letras)" pattern="[A-Za-zÀ-ÿ\s]+" title="Por favor, ingresa solo letras y espacios" maxlength="50" required>
                </div>

                <div class="input-group">
                    <label for="correo">Correo Electrónico:</label>
                    <input type="email" id="correo" name="correo" placeholder="alumno@gmail.com" title="Debe ser un correo electrónico válido" required>
                </div>

                <button type="submit" class="btn-comenzar">Comenzar</button>
            </form>
        </section>
    </div>
</body>
</html>